# Application
NODE_ENV=production
PORT=5000
APP_URL=https://trip.sls-planner.ru

# PostgreSQL target: supabase (default) or yandex
DATABASE_TARGET=supabase

# Supabase / any PostgreSQL connection string
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
# SUPABASE_DATABASE_URL=

# Yandex Managed PostgreSQL (used when DATABASE_TARGET=yandex)
# YANDEX_PG_CONNECTION_STRING=
# YANDEX_PG_HOST=rc1a...mdb.yandexcloud.net
# YANDEX_PG_PORT=6432
# YANDEX_PG_DATABASE=tripplanner
# YANDEX_PG_USER=tripplanner_app
# YANDEX_PG_PASSWORD=
# YANDEX_PG_SSL_CA_FILE=./certs/yandex-root.crt

# Required in production: random value of 32 characters or more
SESSION_SECRET=replace-with-a-long-random-secret-at-least-32-characters

# Optional corporate login through Yandex 360 / Yandex Identity Hub (OIDC)
# Register this exact callback URL in the Yandex application:
# https://YOUR-APP-DOMAIN/api/auth/yandex/callback
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# OIDC_ISSUER=https://auth.yandex.cloud
# OIDC_AUTHORIZATION_URL=https://auth.yandex.cloud/oauth/authorize
# OIDC_TOKEN_URL=https://auth.yandex.cloud/oauth/token
# OIDC_USERINFO_URL=https://auth.yandex.cloud/oauth/userinfo
# OIDC_JWKS_URL=https://auth.yandex.cloud/oauth/jwks/keys
# OIDC_REDIRECT_URI=https://YOUR-APP-DOMAIN/api/auth/yandex/callback
# OIDC_SCOPE=openid email profile
# OIDC_PROMPT=select_account

# Optional one-time administrator for a completely empty database.
# Remove these variables after the first successful login.
# BOOTSTRAP_ADMIN_NAME=Администратор
# BOOTSTRAP_ADMIN_EMAIL=admin@example.ru
# BOOTSTRAP_ADMIN_PASSWORD=Use-a-temporary-strong-password

# Optional SMTP notifications
SMTP_HOST=smtp.example.ru
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=tripplanner@example.ru
SMTP_PASSWORD=replace-with-smtp-app-password
SMTP_FROM=tripplanner@example.ru
